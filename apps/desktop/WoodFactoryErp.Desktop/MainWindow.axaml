<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WoodFactoryErp.Desktop.MainWindow"
        x:CompileBindings="False"
        Title="نظام إدارة مصنع الأخشاب" Width="1180" Height="820"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24" RowDefinitions="Auto,*">
    <TextBlock Text="نظام إدارة مصنع الأخشاب" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Right" />
    <Grid Grid.Row="1" Margin="0,24,0,0">
      <Border x:Name="LoginPanel" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" CornerRadius="12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <StackPanel Spacing="14">
          <TextBlock Text="تسجيل الدخول" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" />
          <TextBlock Text="استخدم حسابك للوصول إلى نظام المصنع" HorizontalAlignment="Right" Opacity="0.75" />
          <TextBlock Text="اسم المستخدم" HorizontalAlignment="Right" />
          <TextBox x:Name="UsernameTextBox" Text="admin" HorizontalContentAlignment="Right" />
          <TextBlock Text="كلمة المرور" HorizontalAlignment="Right" />
          <TextBox x:Name="PasswordTextBox" PasswordChar="●" HorizontalContentAlignment="Right" />
          <TextBlock x:Name="LoginMessageTextBlock" TextWrapping="Wrap" HorizontalAlignment="Right" />
          <Button x:Name="SignInButton" Click="SignInAsync" HorizontalAlignment="Stretch" Content="تسجيل الدخول" />
          <TextBlock Text="الخادم المحلي: http://localhost:3000" HorizontalAlignment="Center" Opacity="0.55" FontSize="12" />
        </StackPanel>
      </Border>

      <Border x:Name="WelcomePanel" IsVisible="False" Padding="18" CornerRadius="12" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <Grid ColumnDefinitions="220,*" ColumnSpacing="20">
          <StackPanel Grid.Column="0" Spacing="10">
            <TextBlock Text="نظام المصنع" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock x:Name="WelcomeTextBlock" HorizontalAlignment="Right" />
            <TextBlock x:Name="RolesTextBlock" TextWrapping="Wrap" HorizontalAlignment="Right" Opacity="0.7" />
            <Separator />
            <Button Click="ShowHome" Content="الرئيسية" HorizontalAlignment="Stretch" />
            <Button x:Name="MasterDataButton" Click="ShowMasterDataAsync" Content="البيانات الأساسية" HorizontalAlignment="Stretch" />
            <Button x:Name="InventoryButton" Content="المخزون" HorizontalAlignment="Stretch" Click="ShowInventoryAsync" />
            <Button x:Name="OrdersButton" Content="الطلبات والملف الفني" HorizontalAlignment="Stretch" Click="ShowOrdersAsync" />
            <Button Content="الإنتاج" HorizontalAlignment="Stretch" IsEnabled="False" />
            <Button Content="المبيعات والمالية" HorizontalAlignment="Stretch" IsEnabled="False" />
            <Button x:Name="AdminButton" Content="إدارة النظام" HorizontalAlignment="Stretch" />
            <Button Click="SignOut" Content="تسجيل الخروج" HorizontalAlignment="Stretch" />
          </StackPanel>

          <Grid Grid.Column="1">
            <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="18" HorizontalAlignment="Stretch">
                <TextBlock Text="الرئيسية" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="مساحة العمل محمية. لا تظهر إلا بعد التحقق من جلسة API صالحة." FontSize="16" HorizontalAlignment="Right" TextWrapping="Wrap" />
                <Border Padding="18" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltLowBrush}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="حالة النظام" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="تم تسجيل الدخول بنجاح. يجري استكمال البيانات الأساسية قبل الانتقال إلى المخزون والإنتاج." TextWrapping="Wrap" HorizontalAlignment="Right" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="MasterDataPanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="1" Text="البيانات الأساسية" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <Button Grid.Column="0" x:Name="RefreshMasterDataButton" Click="RefreshMasterDataAsync" Content="تحديث البيانات" HorizontalAlignment="Left" />
                </Grid>
                <TextBlock Text="إدارة الوحدات والمخازن والعملاء والموردين والأصناف التي يعتمد عليها باقي النظام." HorizontalAlignment="Right" Opacity="0.75" TextWrapping="Wrap" />
                <TextBlock x:Name="MasterDataMessageTextBlock" HorizontalAlignment="Right" TextWrapping="Wrap" />

                <TabControl TabStripPlacement="Top">
                  <TabItem Header="وحدات القياس">
                    <StackPanel Margin="8" Spacing="10">
                      <TextBlock Text="إضافة وحدة قياس" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="الكود" HorizontalAlignment="Right" />
                        <TextBox x:Name="UnitCodeTextBox" Grid.Row="0" Grid.Column="0" Watermark="مثال: PCS" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="الاسم بالعربية" HorizontalAlignment="Right" />
                        <TextBox x:Name="UnitNameArTextBox" Grid.Row="1" Grid.Column="0" Watermark="قطعة" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="الاسم بالإنجليزية" HorizontalAlignment="Right" />
                        <TextBox x:Name="UnitNameEnTextBox" Grid.Row="2" Grid.Column="0" Watermark="Piece" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="عدد الخانات العشرية" HorizontalAlignment="Right" />
                        <TextBox x:Name="UnitPrecisionTextBox" Grid.Row="3" Grid.Column="0" Text="0" />
                      </Grid>
                      <Button x:Name="SaveUnitButton" Click="SaveUnitAsync" Content="حفظ الوحدة" HorizontalAlignment="Right" MinWidth="150" />
                      <Separator />
                      <TextBlock Text="الوحدات المسجلة" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Right" />
                      <TextBlock x:Name="UnitsTextBlock" Text="لا توجد بيانات بعد." TextWrapping="Wrap" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="المخازن">
                    <StackPanel Margin="8" Spacing="10">
                      <TextBlock Text="إضافة مخزن" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="الكود" HorizontalAlignment="Right" />
                        <TextBox x:Name="WarehouseCodeTextBox" Grid.Row="0" Grid.Column="0" Watermark="مثال: RAW-01" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="الاسم بالعربية" HorizontalAlignment="Right" />
                        <TextBox x:Name="WarehouseNameArTextBox" Grid.Row="1" Grid.Column="0" Watermark="مخزن الخامات" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="الاسم بالإنجليزية" HorizontalAlignment="Right" />
                        <TextBox x:Name="WarehouseNameEnTextBox" Grid.Row="2" Grid.Column="0" Watermark="Raw Materials" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="نوع المخزن" HorizontalAlignment="Right" />
                        <ComboBox x:Name="WarehouseTypeComboBox" Grid.Row="3" Grid.Column="0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                      </Grid>
                      <Button x:Name="SaveWarehouseButton" Click="SaveWarehouseAsync" Content="حفظ المخزن" HorizontalAlignment="Right" MinWidth="150" />
                      <Separator />
                      <TextBlock Text="المخازن المسجلة" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Right" />
                      <TextBlock x:Name="WarehousesTextBlock" Text="لا توجد بيانات بعد." TextWrapping="Wrap" />
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="العملاء والموردون">
                    <StackPanel Margin="8" Spacing="10">
                      <TextBlock Text="إضافة عميل أو مورد" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="الكود" HorizontalAlignment="Right" />
                        <TextBox x:Name="PartyCodeTextBox" Grid.Row="0" Grid.Column="0" Watermark="مثال: C-001" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="النوع" HorizontalAlignment="Right" />
                        <ComboBox x:Name="PartyTypeComboBox" Grid.Row="1" Grid.Column="0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="الاسم بالعربية" HorizontalAlignment="Right" />
                        <TextBox x:Name="PartyNameArTextBox" Grid.Row="2" Grid.Column="0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="الاسم بالإنجليزية (اختياري)" HorizontalAlignment="Right" />
                        <TextBox x:Name="PartyNameEnTextBox" Grid.Row="3" Grid.Column="0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="رقم الهاتف (اختياري)" HorizontalAlignment="Right" />
                        <TextBox x:Name="PartyPhoneTextBox" Grid.Row="4" Grid.Column="0" />
                      </Grid>
                      <Button x:Name="SavePartyButton" Click="SavePartyAsync" Content="حفظ العميل / المورد" HorizontalAlignment="Right" MinWidth="180" />
                      <Separator />
                      <TextBlock Text="العملاء والموردون المسجلون" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Right" />
                      <TextBlock x:Name="PartiesTextBlock" Text="لا توجد بيانات بعد." TextWrapping="Wrap" />
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="الأصناف">
                    <StackPanel Margin="8" Spacing="10">
                      <TextBlock Text="إضافة صنف" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="الكود" HorizontalAlignment="Right" />
                        <TextBox x:Name="ItemCodeTextBox" Grid.Row="0" Grid.Column="0" Watermark="مثال: WOOD-001" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="الاسم بالعربية" HorizontalAlignment="Right" />
                        <TextBox x:Name="ItemNameArTextBox" Grid.Row="1" Grid.Column="0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="الاسم بالإنجليزية (اختياري)" HorizontalAlignment="Right" />
                        <TextBox x:Name="ItemNameEnTextBox" Grid.Row="2" Grid.Column="0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="نوع الصنف" HorizontalAlignment="Right" />
                        <ComboBox x:Name="ItemTypeComboBox" Grid.Row="3" Grid.Column="0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="وحدة القياس الأساسية" HorizontalAlignment="Right" />
                        <ComboBox x:Name="ItemBaseUnitComboBox" Grid.Row="4" Grid.Column="0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="التصنيف" HorizontalAlignment="Right" />
                        <ComboBox x:Name="ItemClassificationComboBox" Grid.Row="5" Grid.Column="0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                      </Grid>
                      <CheckBox x:Name="ItemStockTrackedCheckBox" Content="يُتابع رصيد الصنف في المخزن" IsChecked="True" HorizontalAlignment="Right" />
                      <Button x:Name="SaveItemButton" Click="SaveItemAsync" Content="حفظ الصنف" HorizontalAlignment="Right" MinWidth="150" />
                      <Separator />
                      <TextBlock Text="الأصناف المسجلة" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Right" />
                      <TextBlock x:Name="ItemsTextBlock" Text="لا توجد بيانات بعد." TextWrapping="Wrap" />
                    </StackPanel>
                  </TabItem>
                </TabControl>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="InventoryPanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="1" Text="المخزون" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <Button Grid.Column="0" x:Name="RefreshInventoryButton" Click="RefreshInventoryAsync" Content="تحديث المخزون" HorizontalAlignment="Left" />
                </Grid>
                <TextBlock Text="تسجيل استلام خامات. يتم اعتماد الحركة وحساب متوسط التكلفة على الخادم المركزي." HorizontalAlignment="Right" TextWrapping="Wrap" Opacity="0.8" />
                <TextBlock x:Name="InventoryMessageTextBlock" HorizontalAlignment="Right" TextWrapping="Wrap" />
                <Border Padding="14" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltLowBrush}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="استلام خامات جديدة" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="الصنف" HorizontalAlignment="Right" />
                      <ComboBox x:Name="ReceiptItemComboBox" Grid.Row="0" Grid.Column="0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="مخزن الخامات" HorizontalAlignment="Right" />
                      <ComboBox x:Name="ReceiptWarehouseComboBox" Grid.Row="1" Grid.Column="0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="المورد (اختياري)" HorizontalAlignment="Right" />
                      <ComboBox x:Name="ReceiptSupplierComboBox" Grid.Row="2" Grid.Column="0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                      <TextBlock Grid.Row="3" Grid.Column="1" Text="رقم مستند الشراء / المرجع" HorizontalAlignment="Right" />
                      <TextBox x:Name="ReceiptReferenceTextBox" Grid.Row="3" Grid.Column="0" Watermark="مثال: GRN-0001" />
                      <TextBlock Grid.Row="4" Grid.Column="1" Text="تاريخ الاستلام (YYYY-MM-DD)" HorizontalAlignment="Right" />
                      <TextBox x:Name="ReceiptDateTextBox" Grid.Row="4" Grid.Column="0" />
                      <TextBlock Grid.Row="5" Grid.Column="1" Text="الكمية" HorizontalAlignment="Right" />
                      <TextBox x:Name="ReceiptQuantityTextBox" Grid.Row="5" Grid.Column="0" Watermark="مثال: 10" />
                      <TextBlock Grid.Row="6" Grid.Column="1" Text="تكلفة الوحدة بالجنيه" HorizontalAlignment="Right" />
                      <TextBox x:Name="ReceiptUnitCostTextBox" Grid.Row="6" Grid.Column="0" Watermark="مثال: 100" />
                    </Grid>
                    <TextBlock Text="ملاحظات (اختياري)" HorizontalAlignment="Right" />
                    <TextBox x:Name="ReceiptNotesTextBox" Watermark="ملاحظات الاستلام" />
                    <Button x:Name="PostReceiptButton" Click="PostReceiptAsync" Content="تأكيد استلام الخامات" HorizontalAlignment="Right" MinWidth="180" />
                  </StackPanel>
                </Border>
                <TextBlock Text="أرصدة المخزون الحالية" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock x:Name="InventoryBalancesTextBlock" Text="لا توجد أرصدة مخزون بعد." TextWrapping="Wrap" />
                <TextBlock Text="آخر حركات المخزون" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock x:Name="InventoryMovementsTextBlock" Text="لا توجد حركات بعد." TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="OrdersPanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="1" Text="الطلبات والملف الفني" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <Button Grid.Column="0" x:Name="RefreshOrdersButton" Click="RefreshOrdersAsync" Content="تحديث" HorizontalAlignment="Left" />
                </Grid>
                <TextBlock Text="تسجيل طلب العميل، استلام نسخ الملف الفني من المهندس الخارجي، وإعداد قائمة الخامات والقص. المهندس الخارجي لا يحتاج إلى حساب في النظام." HorizontalAlignment="Right" TextWrapping="Wrap" Opacity="0.8" />
                <TextBlock x:Name="OrdersMessageTextBlock" HorizontalAlignment="Right" TextWrapping="Wrap" />
                <Border Padding="12" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltLowBrush}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="الطلب المحدد" VerticalAlignment="Center" />
                    <ComboBox x:Name="SelectedOrderComboBox" Grid.Column="1" SelectionChanged="SelectedOrderChanged">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>
                </Border>
                <TabControl TabStripPlacement="Top">
                  <TabItem Header="طلبات العملاء">
                    <StackPanel Margin="8" Spacing="10">
                      <TextBlock Text="تسجيل طلب عميل جديد" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="رقم الطلب" HorizontalAlignment="Right" />
                        <TextBox x:Name="OrderNumberTextBox" Grid.Row="0" Grid.Column="0" Watermark="مثال: SO-2026-001" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="العميل" HorizontalAlignment="Right" />
                        <ComboBox x:Name="OrderCustomerComboBox" Grid.Row="1" Grid.Column="0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="تاريخ الطلب" HorizontalAlignment="Right" />
                        <TextBox x:Name="OrderDateTextBox" Grid.Row="2" Grid.Column="0" Watermark="YYYY-MM-DD" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="تاريخ التسليم المطلوب (اختياري)" HorizontalAlignment="Right" />
                        <TextBox x:Name="OrderDeliveryDateTextBox" Grid.Row="3" Grid.Column="0" Watermark="YYYY-MM-DD" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="ملاحظات الطلب" HorizontalAlignment="Right" />
                        <TextBox x:Name="OrderNotesTextBox" Grid.Row="4" Grid.Column="0" />
                      </Grid>
                      <Button x:Name="CreateOrderButton" Click="CreateCustomerOrderAsync" Content="حفظ طلب العميل" HorizontalAlignment="Right" MinWidth="170" />
                      <Separator />
                      <TextBlock Text="الطلبات المسجلة" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Right" />
                      <TextBlock x:Name="OrdersListTextBlock" Text="لا توجد طلبات بعد." TextWrapping="Wrap" />
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="النسخ الفنية وقائمة الخامات / القص">
                    <StackPanel Margin="8" Spacing="10">
                      <TextBlock Text="إنشاء نسخة فنية جديدة" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Text="كل تعديل جوهري يُسجل كنسخة جديدة. بعد تثبيت النسخة تصبح بياناتها غير قابلة للتعديل، وتظل النسخ السابقة محفوظة." HorizontalAlignment="Right" TextWrapping="Wrap" />
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="مرجع الرسم / الملف الفني" HorizontalAlignment="Right" />
                        <TextBox x:Name="EngineeringReferenceTextBox" Grid.Row="0" Grid.Column="0" Watermark="رقم الرسم أو مرجع المهندس" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="ملاحظات النسخة" HorizontalAlignment="Right" />
                        <TextBox x:Name="EngineeringNotesTextBox" Grid.Row="1" Grid.Column="0" />
                      </Grid>
                      <Button x:Name="CreateEngineeringPackageButton" Click="CreateEngineeringPackageAsync" Content="إنشاء نسخة فنية مسودة" HorizontalAlignment="Right" MinWidth="210" />
                      <Separator />
                      <TextBlock Text="النسخ الفنية للطلب المحدد" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Right" />
                      <ComboBox x:Name="EngineeringPackageComboBox" SelectionChanged="EngineeringPackageChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                      <TextBlock x:Name="EngineeringPackageSummaryTextBlock" TextWrapping="Wrap" />
                      <Border Padding="12" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltLowBrush}">
                        <StackPanel Spacing="8">
                          <TextBlock Text="إضافة بند لقائمة الخامات أو القص" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" />
                          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="نوع البند" HorizontalAlignment="Right" />
                            <ComboBox x:Name="EngineeringLineTypeComboBox" Grid.Row="0" Grid.Column="0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="وصف الخامة / الجزء" HorizontalAlignment="Right" />
                            <TextBox x:Name="EngineeringLineDescriptionTextBox" Grid.Row="1" Grid.Column="0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="مرجع الخامة (اختياري)" HorizontalAlignment="Right" />
                            <TextBox x:Name="EngineeringLineMaterialReferenceTextBox" Grid.Row="2" Grid.Column="0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="الكمية" HorizontalAlignment="Right" />
                            <TextBox x:Name="EngineeringLineQuantityTextBox" Grid.Row="3" Grid.Column="0" Watermark="مثال: 2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="وحدة القياس" HorizontalAlignment="Right" />
                            <TextBox x:Name="EngineeringLineUnitTextBox" Grid.Row="4" Grid.Column="0" Watermark="مثال: PCS أو M" />
                          </Grid>
                          <TextBlock Text="الأبعاد / المقاسات" HorizontalAlignment="Right" />
                          <TextBox x:Name="EngineeringLineDimensionsTextBox" Watermark="مثال: 1200 × 600 × 18 mm" />
                          <TextBlock Text="ملاحظات البند (اختياري)" HorizontalAlignment="Right" />
                          <TextBox x:Name="EngineeringLineNotesTextBox" />
                          <Button x:Name="AddEngineeringLineButton" Click="AddEngineeringLineAsync" Content="إضافة البند" HorizontalAlignment="Right" MinWidth="150" />
                        </StackPanel>
                      </Border>
                      <Separator />
                      <TextBlock Text="مخرجات المهندس وتصنيف المرفقات" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Text="ارفع صورة المنتج والرسم الهندسي ومخططات الكاتلست. عند اختيار الكاتلست، سجّل نوع اللوح ولونه وسمكه ومقاسه وعدد الألواح كما يظهر في مخرجات المهندس." TextWrapping="Wrap" HorizontalAlignment="Right" Opacity="0.8" />
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="نوع المرفق" HorizontalAlignment="Right" />
                        <ComboBox x:Name="EngineeringAttachmentTypeComboBox" Grid.Row="0" Grid.Column="0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="وصف المرفق (اختياري)" HorizontalAlignment="Right" />
                        <TextBox x:Name="EngineeringAttachmentDescriptionTextBox" Grid.Row="1" Grid.Column="0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="كود / نوع اللوح (للكاتلست)" HorizontalAlignment="Right" />
                        <TextBox x:Name="EngineeringMaterialCodeTextBox" Grid.Row="2" Grid.Column="0" Watermark="مثال: MDF 17 mm" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="اللون / التشطيب (للكاتلست)" HorizontalAlignment="Right" />
                        <TextBox x:Name="EngineeringMaterialColorTextBox" Grid.Row="3" Grid.Column="0" Watermark="مثال: بني أو أبيض" />
                      </Grid>
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="سمك اللوح (مم)" HorizontalAlignment="Right" />
                        <TextBox x:Name="EngineeringBoardThicknessTextBox" Grid.Row="0" Grid.Column="0" Watermark="مثال: 17" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="طول اللوح (مم)" HorizontalAlignment="Right" />
                        <TextBox x:Name="EngineeringBoardLengthTextBox" Grid.Row="1" Grid.Column="0" Watermark="مثال: 2420" />
                      </Grid>
                      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="عرض اللوح (مم)" HorizontalAlignment="Right" />
                        <TextBox x:Name="EngineeringBoardWidthTextBox" Grid.Row="0" Grid.Column="0" Watermark="مثال: 1210" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="عدد الألواح المستخدمة" HorizontalAlignment="Right" />
                        <TextBox x:Name="EngineeringBoardQuantityTextBox" Grid.Row="1" Grid.Column="0" Watermark="العدد حسب مخطط الكاتلست" />
                      </Grid>
                      <TextBlock Text="مرفقات النسخة الفنية" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Button x:Name="UploadEngineeringFileButton" Grid.Column="0" Click="UploadEngineeringFileAsync" Content="رفع ملف" />
                        <ComboBox x:Name="EngineeringPackageFileComboBox" Grid.Column="1"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                      </Grid>
                      <Button x:Name="DownloadEngineeringFileButton" Click="DownloadEngineeringFileAsync" Content="تنزيل المرفق المحدد" HorizontalAlignment="Right" />
                      <Border Padding="12" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltLowBrush}">
                        <StackPanel Spacing="8">
                          <TextBlock Text="تفاصيل القطع في الكاتلست" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" />
                          <TextBlock Text="اربط كل قطعة بمخطط كاتلست مرفوع. تحفظ المقاسات والكميات كما أدخلها المستخدم؛ النظام لا يعيد تحسين توزيع القص تلقائياً." TextWrapping="Wrap" HorizontalAlignment="Right" Opacity="0.8" />
                          <TextBlock Text="مخطط الكاتلست" HorizontalAlignment="Right" />
                          <ComboBox x:Name="EngineeringCutListFileComboBox"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="اسم القطعة" HorizontalAlignment="Right" />
                            <TextBox x:Name="EngineeringCutListPartNameTextBox" Grid.Row="0" Grid.Column="0" Watermark="مثال: جنب البوكس" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="الطول (مم)" HorizontalAlignment="Right" />
                            <TextBox x:Name="EngineeringCutListPartLengthTextBox" Grid.Row="1" Grid.Column="0" Watermark="مثال: 868" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="العرض (مم)" HorizontalAlignment="Right" />
                            <TextBox x:Name="EngineeringCutListPartWidthTextBox" Grid.Row="2" Grid.Column="0" Watermark="مثال: 382" />
                          </Grid>
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="1" Spacing="4">
                              <TextBlock Text="سمك القطعة (مم، اختياري)" HorizontalAlignment="Right" />
                              <TextBox x:Name="EngineeringCutListPartThicknessTextBox" Watermark="يُترك فارغاً لاستخدام سمك اللوح" />
                            </StackPanel>
                            <StackPanel Grid.Column="0" Spacing="4">
                              <TextBlock Text="عدد القطع" HorizontalAlignment="Right" />
                              <TextBox x:Name="EngineeringCutListPartQuantityTextBox" Watermark="مثال: 2" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Text="ملاحظات القطعة (اختياري)" HorizontalAlignment="Right" />
                          <TextBox x:Name="EngineeringCutListPartNotesTextBox" />
                          <Button x:Name="AddEngineeringCutListPartButton" Click="AddEngineeringCutListPartAsync" Content="إضافة القطعة للكاتلست" HorizontalAlignment="Right" MinWidth="190" IsEnabled="False" />
                          <TextBlock x:Name="EngineeringCutListPartsTextBlock" Text="لا توجد قطع مسجلة من الكاتلست بعد." TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <Button x:Name="FinalizeEngineeringPackageButton" Click="FinalizeEngineeringPackageAsync" Content="تثبيت النسخة الفنية" HorizontalAlignment="Right" MinWidth="180" />
                      <TextBlock Text="بنود النسخة المحددة" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Right" />
                      <TextBlock x:Name="EngineeringLinesTextBlock" Text="لا توجد بنود بعد." TextWrapping="Wrap" />
                    </StackPanel>
                  </TabItem>

                  <TabItem Header="أمر شغل وتجهيز إنتاج (Job Order)">
                    <StackPanel Margin="8" Spacing="10">
                      <TextBlock Text="أمر شغل وتجهيز إنتاج — مطابق لنموذج المصنع" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Text="أنشئ أمر الإنتاج المرتبط بطلب العميل والنسخة الفنية المثبتة، ثم املأ بنود نموذج أمر الشغل واحفظه. يمكن تنزيل نسخة PDF من صفحتين بمقاس A3." HorizontalAlignment="Right" TextWrapping="Wrap" Opacity="0.85" />
                      <Border Padding="12" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltLowBrush}">
                        <StackPanel Spacing="8">
                          <TextBlock Text="إنشاء أمر شغل جديد" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="رقم أمر الإنتاج" HorizontalAlignment="Right" />
                            <TextBox x:Name="ProductionOrderNumberTextBox" Grid.Row="0" Grid.Column="0" Watermark="مثال: JO-2026-001" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="كود المنتج / المواصفة" HorizontalAlignment="Right" />
                            <TextBox x:Name="ProductionProductCodeTextBox" Grid.Row="1" Grid.Column="0" Watermark="كود يميز مواصفة المنتج" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="اسم المنتج" HorizontalAlignment="Right" />
                            <TextBox x:Name="ProductionProductNameTextBox" Grid.Row="2" Grid.Column="0" Watermark="مثال: دولاب جرار" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="تاريخ أمر الشغل (YYYY-MM-DD)" HorizontalAlignment="Right" />
                            <TextBox x:Name="ProductionDateTextBox" Grid.Row="3" Grid.Column="0" Watermark="YYYY-MM-DD" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="الكمية المطلوبة" HorizontalAlignment="Right" />
                            <TextBox x:Name="ProductionPlannedQuantityTextBox" Grid.Row="4" Grid.Column="0" Watermark="مثال: 5" />
                          </Grid>
                          <Button x:Name="CreateProductionOrderButton" Click="CreateDraftProductionOrderAsync" Content="إنشاء أمر الشغل" HorizontalAlignment="Right" MinWidth="190" />
                        </StackPanel>
                      </Border>
                      <Separator />
                      <TextBlock Text="اختر أمر الشغل لتعبئة النموذج أو تنزيل PDF" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <ComboBox x:Name="ProductionOrderComboBox" SelectionChanged="ProductionOrderChanged">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock x:Name="ProductionWorkOrderSummaryTextBlock" TextWrapping="Wrap" HorizontalAlignment="Right" />
                      <Border Padding="6" CornerRadius="5" Background="#243F85">
                        <Grid ColumnDefinitions="95,105,4*,2*,38" ColumnSpacing="6">
                          <TextBlock Grid.Column="0" Text="العدد / الكمية" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="الوحدة" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="المواصفات / المقاس / البيان" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="3" Text="اسم البند / الخامة" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" />
                          <TextBlock Grid.Column="4" Text="اختيار" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Grid>
                      </Border>
                      <StackPanel x:Name="ProductionWorkOrderLinesPanel" Spacing="2" />
                      <TextBlock Text="صفّا الإضافات الأخرى مطابقان للنموذج المطبوع. اكتب اسم البند ومواصفاته ووحدته وكميته عند الحاجة." HorizontalAlignment="Right" TextWrapping="Wrap" Opacity="0.8" />
                      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Button x:Name="SaveProductionWorkOrderButton" Grid.Column="0" Click="SaveProductionWorkOrderAsync" Content="حفظ أمر الشغل" MinWidth="150" />
                        <Button x:Name="DownloadProductionWorkOrderPdfButton" Grid.Column="1" Click="DownloadProductionWorkOrderPdfAsync" Content="تحميل أمر الشغل PDF" MinWidth="190" />
                        <TextBlock x:Name="ProductionWorkOrderMessageTextBlock" Grid.Column="2" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Right" />
                      </Grid>
                      <Separator />
                      <TextBlock Text="أوامر الإنتاج المسجلة" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock x:Name="ProductionOrdersTextBlock" Text="لا توجد أوامر إنتاج بعد." TextWrapping="Wrap" />
                    </StackPanel>
                  </TabItem>
                </TabControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
